 #include "usb/standard/requests.hpp"
 
 namespace usb::df
@@ -89,23 +90,30 @@ void mac::set_config(config::view config)
 
 usb::result mac::remote_wakeup()
 {
+    const auto finish = [](usb::result result)
+    {
+        diag::remote_wakeup_result(result.to_int());
+        return result;
+    };
     if (!std_status().remote_wakeup)
     {
-        return usb::result::operation_not_permitted;
+        return finish(usb::result::operation_not_permitted);
     }
     if (power_state() == power::state::L0_ON)
     {
-        return usb::result::already_connected;
+        return finish(usb::result::already_connected);
     }
     if (power_state() == power::state::L3_OFF)
     {
-        return usb::result::not_connected;
+        return finish(usb::result::not_connected);
     }
