diff --git a/c2usb/usb/df/mac_diag.cpp b/c2usb/usb/df/mac_diag.cpp
new file mode 100644
index 0000000..7ac5d9b
--- /dev/null
+++ b/c2usb/usb/df/mac_diag.cpp
@@ -0,0 +1,454 @@
+/// @file
+///
+/// UHK patch: port-agnostic MAC anomaly diagnostics, see mac_diag.hpp.
+///
+#include "usb/df/mac_diag.hpp"
+#include <cstddef>
+#include "usb/df/mac.hpp"
+#ifdef __ZEPHYR__
+#include <zephyr/kernel.h>
+#else
+#include <fsl_common.h>
+#endif
+
+extern "C" __attribute__((weak)) void c2usb_log(const char*, ...) {}
+extern "C" __attribute__((weak)) uint32_t c2usb_diag_time_ms(void)
+{
+    return 0;
+}
+extern "C" __attribute__((weak)) void c2usb_diag_dump_port(void) {}
+
+using namespace usb::df;
+
+namespace
+{
+const char* const category_names[diag::CATEGORY_COUNT] = {
+    "enqueue fail", "EP error",       "ctrl error",      "ctrl stall",
+    "evt dropped",  "EP busy reject", "no-power reject",
+};
+
+enum class event_type : uint8_t
+{
+    BUS,
+    CONTROL_SETUP,
+    ENQUEUE_FAIL,
+    EP_ERROR,
+    CTRL_ERROR,
+    CTRL_STALL,
+    EVENT_DROPPED,
+    EP_BUSY,
+    EP_NO_POWER,
+    EP_SUCCESS,
+    REMOTE_WAKEUP_RESULT,
+};
+
+struct diag_stat
+{
+    uint32_t total;     // since boot / reset
+    uint32_t since_ok;  // since last successful data EP transfer
+    uint32_t last_time; // ms
+    int last_err;
+    uint8_t last_ep;
+};
+
+struct diag_bus_entry
+{
+    uint32_t time;
+    uint32_t count; // consecutive events of the same type are collapsed
+    diag::bus_event type;
+};
+
+constexpr size_t BUS_RING_SIZE = 16;
+constexpr size_t EVENT_RING_SIZE = 64;
+constexpr size_t EVENT_DUMP_SIZE = 16;
+constexpr size_t DATA_EP_COUNT = 30;
+
+struct diag_event
+{
+    uint32_t time;
+    uint32_t sequence;
+    int32_t value;
+    uint8_t type;
+    uint8_t ep;
+    uint8_t detail0;
+    uint8_t detail1;
+};
+
+struct diag_ep_success
+{
+    uint32_t count;
+    uint32_t last_time;
+};
+
+struct diag_state
+{
+    diag_stat stats[diag::CATEGORY_COUNT];
+    diag_bus_entry bus_ring[BUS_RING_SIZE];
+    diag_event event_ring[EVENT_RING_SIZE];
+    diag_ep_success ep_success[DATA_EP_COUNT];
+    uint8_t bus_ring_next;
+    uint8_t event_ring_next;
+    uint8_t event_count;
+    uint32_t event_sequence;
+    uint32_t event_overwritten;
+    bool event_activity_since_success;
+    uint32_t last_ok_time;
+    uint8_t last_ok_ep;
+    uint32_t ok_count;
+    mac* mac_;
+};
+
+#ifdef __ZEPHYR__
+static k_spinlock state_lock;
+
+class state_guard
+{
+  public:
+    state_guard()
+        : key_(k_spin_lock(&state_lock))
+    {}
+    ~state_guard() { k_spin_unlock(&state_lock, key_); }
+    state_guard(const state_guard&) = delete;
+    state_guard& operator=(const state_guard&) = delete;
+    state_guard(state_guard&&) = delete;
+    state_guard& operator=(state_guard&&) = delete;
+
+  private:
+    k_spinlock_key_t key_;
+};
+#else
+class state_guard
+{
+  public:
+    state_guard()
+        : primask_(__get_PRIMASK())
+    {
+        __disable_irq();
+    }
+    ~state_guard()
+    {
+        if (primask_ == 0)
+        {
+            __enable_irq();
+        }
+    }
+    state_guard(const state_guard&) = delete;
+    state_guard& operator=(const state_guard&) = delete;
+    state_guard(state_guard&&) = delete;
+    state_guard& operator=(state_guard&&) = delete;
+
+  private:
+    uint32_t primask_;
+};
+#endif
+
+diag_state state{};
+
+void append_event(event_type type, uint8_t ep, uint8_t detail0, uint8_t detail1, int32_t value,
+                  uint32_t time)
+{
+    state.event_ring[state.event_ring_next] = {
+        time, ++state.event_sequence, value, static_cast<uint8_t>(type), ep, detail0, detail1};
+    state.event_ring_next = (state.event_ring_next + 1) % EVENT_RING_SIZE;
+    if (state.event_count < EVENT_RING_SIZE)
+    {
+        state.event_count++;
+    }
+    else
+    {
+        state.event_overwritten++;
+    }
+}
+
+event_type event_type_for(diag::category cat)
+{
+    switch (cat)
+    {
+    case diag::ENQUEUE_FAIL:
+        return event_type::ENQUEUE_FAIL;
+    case diag::EP_ERROR:
+        return event_type::EP_ERROR;
+    case diag::CTRL_ERROR:
+        return event_type::CTRL_ERROR;
+    case diag::CTRL_STALL:
+        return event_type::CTRL_STALL;
+    case diag::EVENT_DROPPED:
+        return event_type::EVENT_DROPPED;
+    case diag::EP_BUSY:
+        return event_type::EP_BUSY;
+    case diag::EP_NO_POWER:
+        return event_type::EP_NO_POWER;
+    default:
+        return event_type::EP_ERROR;
+    }
+}
+
+int endpoint_index(uint8_t ep)
+{
+    const uint8_t number = ep & 0x0F;
+    if (number == 0 or (ep & 0x70) != 0)
+    {
+        return -1;
+    }
+    return ((ep & 0x80) ? 15 : 0) + number - 1;
+}
+
+uint8_t endpoint_address(size_t index)
+{
+    return index < 15 ? static_cast<uint8_t>(index + 1) : static_cast<uint8_t>(0x80 + index - 14);
+}
+
+const char* bus_name(diag::bus_event type)
+{
+    switch (type)
+    {
+    case diag::bus_event::RESET:
+        return "reset";
+    case diag::bus_event::SUSPEND:
+        return "suspend";
+    case diag::bus_event::RESUME:
+        return "resume";
+    case diag::bus_event::SLEEP:
+        return "sleep";
+    case diag::bus_event::VBUS_ON:
+        return "vbus-on";
+    case diag::bus_event::VBUS_OFF:
+        return "vbus-off";
+    case diag::bus_event::ERROR:
+        return "error";
+    default:
+        return "?";
+    }
+}
+
+const char* event_name(event_type type)
+{
+    switch (type)
+    {
+    case event_type::ENQUEUE_FAIL:
+        return "enqueue-fail";
+    case event_type::EP_ERROR:
+        return "ep-error";
+    case event_type::CTRL_ERROR:
+        return "ctrl-error";
+    case event_type::CTRL_STALL:
+        return "ctrl-stall";
+    case event_type::EVENT_DROPPED:
+        return "event-dropped";
+    case event_type::EP_BUSY:
+        return "ep-busy";
+    case event_type::EP_NO_POWER:
+        return "ep-no-power";
+    case event_type::EP_SUCCESS:
+        return "ep-ok-after-anomaly";
+    case event_type::REMOTE_WAKEUP_RESULT:
+        return "wakeup-result";
+    default:
+        return "?";
+    }
+}
+
+const char* power_name(usb::power::state s)
+{
+    switch (s)
+    {
+    case usb::power::state::L0_ON:
+        return "L0-on";
+    case usb::power::state::L1_SLEEP:
+        return "L1-sleep";
+    case usb::power::state::L2_SUSPEND:
+        return "L2-suspend";
+    case usb::power::state::L3_OFF:
+        return "L3-off";
+    default:
+        return "?";
+    }
+}
+} // namespace
+
+namespace usb::df::diag
+{
+void record(category cat, uint8_t ep, int err)
+{
+    state_guard guard;
+    auto& s = state.stats[cat];
+    s.total++;
+    s.since_ok++;
+    s.last_time = c2usb_diag_time_ms();
+    s.last_err = err;
+    s.last_ep = ep;
+    state.event_activity_since_success = true;
+    append_event(event_type_for(cat), ep, 0, 0, err, s.last_time);
+}
+
+void success(uint8_t ep)
+{
+    state_guard guard;
+    const uint32_t now = c2usb_diag_time_ms();
+    const bool recovery = state.event_activity_since_success;
+    state.ok_count++;
+    state.last_ok_time = now;
+    state.last_ok_ep = ep;
+    if (int index = endpoint_index(ep); index >= 0)
+    {
+        auto& endpoint = state.ep_success[index];
+        endpoint.count++;
+        endpoint.last_time = now;
+    }
+    if (recovery)
+    {
+        append_event(event_type::EP_SUCCESS, ep, 0, 0, 0, now);
+    }
+    state.event_activity_since_success = false;
+    for (auto& s : state.stats)
+    {
+        s.since_ok = 0;
+    }
+}
+
+void bus(bus_event event)
+{
+    state_guard guard;
+    const uint32_t now = c2usb_diag_time_ms();
+    auto& last = state.bus_ring[(state.bus_ring_next + BUS_RING_SIZE - 1) % BUS_RING_SIZE];
+    if (last.count and (last.type == event))
+    {
+        last.count++;
+        last.time = now;
+    }
+    else
+    {
+        state.bus_ring[state.bus_ring_next] = {now, 1, event};
+        state.bus_ring_next = (state.bus_ring_next + 1) % BUS_RING_SIZE;
+    }
+    append_event(event_type::BUS, 0, static_cast<uint8_t>(event), 0, 0, now);
+    state.event_activity_since_success = true;
+}
+
+void control_setup(uint8_t bm_request_type, uint8_t b_request, uint16_t w_value)
+{
+    state_guard guard;
+    append_event(event_type::CONTROL_SETUP, 0, bm_request_type, b_request, w_value,
+                 c2usb_diag_time_ms());
+    state.event_activity_since_success = true;
+}
+
+void remote_wakeup_result(int err)
+{
+    state_guard guard;
+    append_event(event_type::REMOTE_WAKEUP_RESULT, 0, 0, 0, err, c2usb_diag_time_ms());
+    state.event_activity_since_success = true;
+}
+
+void set_mac(mac* m)
+{
+    state_guard guard;
+    state.mac_ = m;
+}
+} // namespace usb::df::diag
+
+extern "C" void c2usb_diag_reset(void)
+{
+    state_guard guard;
+    auto* mac_ = state.mac_;
+    state = {};
+    state.mac_ = mac_;
+}
+
+extern "C" void c2usb_diag_dump(void)
+{
+    diag_state snapshot;
+    {
+        state_guard guard;
+        snapshot = state;
+    }
+    auto* mac_ = snapshot.mac_;
+    uint32_t now = c2usb_diag_time_ms();
+
+    c2usb_log("c2usb diag (t=%u ms):\n", (unsigned)now);
+    if (mac_)
+    {
+        c2usb_log("  power=%s configured=%d active=%d\n", power_name(mac_->power_state()),
+                  (int)mac_->configured(), (int)mac_->active());
+    }
+    else
+    {
+        c2usb_log("  no MAC instance\n");
+    }
+    c2usb_diag_dump_port();
+    if (snapshot.ok_count)
+    {
+        c2usb_log("  last ok transfer: EP %02x, %u ms ago (%u total)\n", snapshot.last_ok_ep,
+                  (unsigned)(now - snapshot.last_ok_time), (unsigned)snapshot.ok_count);
+    }
+    else
+    {
+        c2usb_log("  no successful data EP transfer yet\n");
+    }
+    for (uint8_t i = 0; i < diag::CATEGORY_COUNT; i++)
+    {
+        const auto& s = snapshot.stats[i];
+        if (s.total)
+        {
+            c2usb_log("  %s: total=%u sinceOk=%u, last: EP %02x err=%d %u ms ago\n",
+                      category_names[i], (unsigned)s.total, (unsigned)s.since_ok, s.last_ep,
+                      s.last_err, (unsigned)(now - s.last_time));
+        }
+    }
+    for (size_t i = 0; i < DATA_EP_COUNT; ++i)
+    {
+        const auto& endpoint = snapshot.ep_success[i];
+        if (endpoint.count)
+        {
+            c2usb_log("  EP %02x successful transfers: %u, last %u ms ago\n", endpoint_address(i),
+                      (unsigned)endpoint.count, (unsigned)(now - endpoint.last_time));
+        }
+    }
+    for (size_t i = 0; i < BUS_RING_SIZE; i++)
+    {
+        const auto& e = snapshot.bus_ring[(snapshot.bus_ring_next + i) % BUS_RING_SIZE];
+        if (e.count)
+        {
+            c2usb_log("  bus event: %s x%u, last %u ms ago\n", bus_name(e.type), (unsigned)e.count,
+                      (unsigned)(now - e.time));
+        }
+    }
+    const size_t event_dump_count = std::min<size_t>(snapshot.event_count, EVENT_DUMP_SIZE);
+    c2usb_log("  event journal: %u retained, showing %u, %u overwritten\n", snapshot.event_count,
+              (unsigned)event_dump_count, (unsigned)snapshot.event_overwritten);
+    const size_t first =
+        (snapshot.event_ring_next + EVENT_RING_SIZE - event_dump_count) % EVENT_RING_SIZE;
+    for (size_t i = 0; i < event_dump_count; ++i)
+    {
+        const auto& event = snapshot.event_ring[(first + i) % EVENT_RING_SIZE];
+        const auto type = static_cast<event_type>(event.type);
+        const auto age = (unsigned)(now - event.time);
+        if (type == event_type::BUS)
+        {
+            c2usb_log("    #%u +%u ms bus %s\n", (unsigned)event.sequence, age,
+                      bus_name(static_cast<diag::bus_event>(event.detail0)));
+        }
+        else if (type == event_type::CONTROL_SETUP)
+        {
+            c2usb_log("    #%u +%u ms setup bm=%02x req=%02x wValue=%04x\n",
+                      (unsigned)event.sequence, age, event.detail0, event.detail1,
+                      (unsigned)event.value);
+        }
+        else
+        {
+            c2usb_log("    #%u +%u ms %s", (unsigned)event.sequence, age, event_name(type));
+            if (type == event_type::EP_SUCCESS)
+            {
+                c2usb_log(" ep=%02x\n", event.ep);
+            }
+            else if (type == event_type::REMOTE_WAKEUP_RESULT)
+            {
+                c2usb_log(" err=%d\n", event.value);
+            }
+            else
+            {
+                c2usb_log(" ep=%02x value=%d\n", event.ep, event.value);
+            }
+        }
+    }
+}
diff --git a/c2usb/usb/df/mac_diag.hpp b/c2usb/usb/df/mac_diag.hpp
new file mode 100644
index 0000000..20b57ee
--- /dev/null
+++ b/c2usb/usb/df/mac_diag.hpp
@@ -0,0 +1,84 @@
+/// @file
+///
+/// UHK patch: injectable logging + port-agnostic anomaly diagnostics for MACs.
+///
+/// MAC ports record every anomaly (enqueue failures, EP errors, control errors,
+/// stalls, dropped events, rejected transfers) together with bus-level events
+/// (reset/suspend/resume/Vbus). Counters distinguish totals since boot from
+/// occurrences since the last successful data-endpoint transfer, so a dump
+/// answers "what went wrong since USB last worked".
+///
+/// The host application may provide a printf-like `c2usb_log()` and a
+/// millisecond time source `c2usb_diag_time_ms()`; weak defaults keep c2usb
+/// standalone-linkable.
+///
+#ifndef __USB_DF_MAC_DIAG_HPP_
+#define __USB_DF_MAC_DIAG_HPP_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+    /// Printf-like log output, overridable by the application (weak no-op default).
+    void c2usb_log(const char* fmt, ...);
+
+    /// Millisecond timestamp source, overridable by the application or port
+    /// (weak default returns 0).
+    uint32_t c2usb_diag_time_ms(void);
+
+    /// Dump current MAC state and all recorded anomalies via c2usb_log().
+    void c2usb_diag_dump(void);
+
+    /// Clear all recorded diagnostics.
+    void c2usb_diag_reset(void);
+
+    /// Port-specific extra dump output (weak no-op default).
+    void c2usb_diag_dump_port(void);
+
+#ifdef __cplusplus
+}
+
+namespace usb::df
+{
+class mac;
+
+namespace diag
+{
+enum category : uint8_t
+{
+    ENQUEUE_FAIL = 0, // handing a transfer to the controller driver failed
+    EP_ERROR,         // data endpoint transfer failed / was cancelled
+    CTRL_ERROR,       // control endpoint event with error
+    CTRL_STALL,       // control pipeline stalled by the MAC
+    EVENT_DROPPED,    // driver event lost (e.g. queue full)
+    EP_BUSY,          // transfer rejected: endpoint busy
+    EP_NO_POWER,      // transfer rejected: bus not in L0
+    CATEGORY_COUNT
+};
+
+enum class bus_event : uint8_t
+{
+    RESET = 0,
+    SUSPEND,
+    RESUME,
+    SLEEP,
+    VBUS_ON,
+    VBUS_OFF,
+    ERROR,
+};
+
+// all callable from any context including ISR - they must not log
+void record(category cat, uint8_t ep, int err);
+void success(uint8_t ep);
+void bus(bus_event event);
+void control_setup(uint8_t bm_request_type, uint8_t b_request, uint16_t w_value);
+void remote_wakeup_result(int err);
+void set_mac(mac* m);
+} // namespace diag
+} // namespace usb::df
+#endif
+
+#endif // __USB_DF_MAC_DIAG_HPP_
