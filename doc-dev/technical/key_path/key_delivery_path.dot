digraph key_delivery_path {
// Life of a key on UHK80: from the left half's matrix to the host, and what happens when a hop fails.
// Describes branch usb-sender-cleanup. Open in sane-graph-edit; "link-c" (gc) opens the code.
// Paths are relative to this file.
// Two drawings:
// - right: the path as outcome flows, one cluster per hop (root -> common step -> good / bad outcome).
// - left (x < -1300): Karel's sketch of the call flow in the semaphore and the report sender.
// Invariants and gaps of the report sender are listed in ../usb_report_delivery.md.

// ---------- title, legend ----------
kt [ fontsize="26.4"; label="Life of a key\n(AI)"; pos="0.0,-1420.0!" ];
kt_d [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="matrix scan -> host:\nwhat happens when a hop fails"; pos="300.0,-1420.0!" ];

lg0 [ fontsize="15.6"; label="Legend"; pos="-1100.0,-1420.0!" ];
lg1 [ fontsize="12.0"; label="module (root of a cluster)"; pos="-1100.0,-1380.0!" ];
lg2 [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="step of both the good and the bad path"; pos="-1100.0,-1340.0!" ];
lg3 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="good path"; pos="-1100.0,-1300.0!" ];
lg4 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="bad path"; pos="-1100.0,-1260.0!" ];
lg5 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="condition / note"; pos="-1100.0,-1220.0!" ];
lg6 [ fontsize="12.0"; label="INVARIANT: / GAP: plain text"; pos="-1100.0,-1180.0!" ];

// ---------- left half ----------
s_left [ fontsize="15.6"; label="Left half"; pos="0.0,-1320.0!" ];
a_scan [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="Key scanner\nfull bitmap, on change"; pos="-300.0,-1240.0!"; "link-c"="../../../device/src/keyboard/key_scanner.c:/^static void scanAllKeys.*[{]$/,/^}/" ];
a_mod [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="Left module\nkeys + pointer deltas"; pos="0.0,-1240.0!"; "link-c"="../../../right/src/slave_drivers/uhk_module_driver.c:/if [(]UhkModuleDriver_ResendKeyStates/,+6" ];
a_ss [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="StateSync\ndirty properties"; pos="300.0,-1240.0!"; "link-c"="../../../device/src/state_sync.c:/^static void submitPreparedData/,/^}/" ];
a_msg [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="Messenger Send2\nno retry of its own"; pos="0.0,-1150.0!"; "link-c"="../../../device/src/messenger.c:/^int Messenger_Send2[(]/,/^}/" ];
a_test [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="[test] MessengerFailure:\n1 in 4 sends fail,\ntyped keys still arrive"; pos="-380.0,-1150.0!"; "link-c"="../../../right/src/test_suite/tests/test_messenger_failure.c" ];
a_ok [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="Send ok"; pos="0.0,-1070.0!" ];
a_fail [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="Send failed"; pos="300.0,-1070.0!" ];
a_mark [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="marked for resend:\nnext scan / dirty again"; pos="300.0,-990.0!" ];
a_gap [ fontsize="12.0"; label="GAP: failed pointer deltas\nstay lost"; pos="580.0,-990.0!" ];
a_inv [ fontsize="12.0"; label="INVARIANT:\na failed send leaves its data\nmarked for resend"; pos="580.0,-1070.0!" ];
a_reset [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="Link reset"; pos="600.0,-1240.0!" ];
a_all [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="all key states resent"; pos="600.0,-1150.0!"; "link-c"="../../../device/src/state_sync.c:/KeyScanner_ResendKeyStates = true/,+1" ];

// ---------- link between the halves ----------
s_link [ fontsize="15.6"; label="Link between halves"; pos="0.0,-900.0!" ];
b_uart [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="UART bridge\n(cable)"; pos="-330.0,-820.0!"; "link-c"="../../../device/src/keyboard/uart_bridge.c" ];
b_ack [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="CRC ok, ack"; pos="-110.0,-740.0!" ];
b_nack [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="nack / CRC error"; pos="-330.0,-740.0!" ];
b_rsnd [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="resend frame"; pos="-330.0,-660.0!" ];
b_ping [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="ping timeout"; pos="-560.0,-740.0!" ];
b_down [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="link down"; pos="-560.0,-660.0!" ];
b_kres [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="key states resent"; pos="-560.0,-580.0!" ];
b_nus [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="NUS\n(wireless)"; pos="330.0,-820.0!"; "link-c"="../../../device/src/nus_server.c:/^static bool takeSlot/,/^}/" ];
b_slot [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="send slot taken"; pos="200.0,-740.0!" ];
b_radio [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="[radio] ack + retransmit"; pos="200.0,-660.0!" ];
b_noslot [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="no slot in 1 s"; pos="460.0,-740.0!" ];
b_cut [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="disconnect that link"; pos="460.0,-660.0!" ];
b_gap [ fontsize="12.0"; label="GAP: slots are shared by all\ndongle links: the wrong one\nmay be cut"; pos="720.0,-740.0!"; "link-c"="../../../device/src/nus_server.c:/^static bool takeSlot/,/^}/" ];
b_wm [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="receiver watermark\ndrops resent duplicates"; pos="0.0,-570.0!" ];

// ---------- right half ----------
s_right [ fontsize="15.6"; label="Right half\nKeyStates[left]"; pos="0.0,-480.0!" ];
s_main [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="Main loop\nkey processing, postponer"; pos="0.0,-400.0!" ];

// ---------- report sender ----------
s_snd [ fontsize="15.6"; label="Report sender"; pos="0.0,-310.0!"; "link-c"="../../../right/src/usb_semaphore.h" ];
c_doc [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="invariants, gaps, history:\nusb_report_delivery.md"; pos="300.0,-310.0!"; "link-c"="../usb_report_delivery.md" ];
c_gate [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="a report in flight or retried:\nno new pass, for all kinds"; pos="-300.0,-310.0!"; "link-c"="../../../right/src/usb_semaphore.c:/^static bool recalculateReport/,/^}/" ];
c_inv_seq [ fontsize="12.0"; label="INVARIANT:\nreports keep their sequence,\nalso across interfaces"; pos="-640.0,-320.0!" ];
c_gap_pm [ fontsize="12.0"; label="GAP: gate not checked\noutside awake power modes"; pos="-640.0,-230.0!" ];
c_pass [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="Pass:\nsend what differs\nfrom the baseline"; pos="0.0,-220.0!"; "link-c"="../../../right/src/usb_report_sender.c:/^static void sendActiveReports/,/^}/" ];
c_down [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="interface down\n(mouse, controls):\nnot sent"; pos="-300.0,-220.0!"; "link-c"="../../../right/src/hid/transport.cpp:/^static bool isInterfaceUp/,/^}/" ];
c_send [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="Send"; pos="0.0,-130.0!" ];
c_acc [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="accepted:\nin flight"; pos="0.0,-50.0!"; "link-c"="../../../right/src/usb_semaphore.c:/^void UsbSemaphore_Take/,/^}/" ];
c_conf [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="confirmed"; pos="0.0,30.0!"; "link-c"="../../../right/src/hid/transport.cpp:/^static void reportSentCallback.*[)]$/,/^}/" ];
c_adv [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="baseline advances\nretries := 0"; pos="0.0,110.0!"; "link-c"="../../../right/src/usb_semaphore.c:/^bool UsbSemaphore_Release/,/^}/" ];
c_inv_base [ fontsize="12.0"; label="INVARIANT:\nthe baseline advances on confirmed\ndelivery or on give-up, nowhere else"; pos="330.0,115.0!" ];
c_rej [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="rejected"; pos="-280.0,-50.0!" ];
c_to [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="unconfirmed 32 ms\n(USB, dongle)"; pos="-280.0,30.0!" ];
c_inv_wait [ fontsize="12.0"; label="INVARIANT:\nnothing waits on a peer forever"; pos="-280.0,115.0!" ];
c_fail [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="failed attempt"; pos="-560.0,-10.0!"; "link-c"="../../../right/src/usb_report_sender.c:/^bool UsbReportSender_Fail/,/^}/" ];
c_retry [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="up to 12 times:\nbackoff 1..32 ms,\nresend pass"; pos="-820.0,-100.0!" ];
c_give [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="13th failure,\nor host gone"; pos="-820.0,10.0!"; "link-c"="../../../right/src/usb_report_sender.c:/^bool UsbReportSender_ShouldGiveUp/,/^}/" ];
c_drop [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="Give up:\nreport dropped\nbaseline advances\nretries := MAX"; pos="-820.0,125.0!"; "link-c"="../../../right/src/usb_report_sender.c:/^static bool resendOrGiveUp/,/^}/" ];
c_latch [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="next reports of this kind:\none attempt each"; pos="-820.0,240.0!" ];
c_rec [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="BLE, dongle link:\nreconnect"; pos="-1080.0,125.0!"; "link-c"="../../../right/src/usb_report_sender.c:/^static void handleUltimateFail/,/^}/" ];
c_gap_w1 [ fontsize="12.0"; label="GAP: a link that rejects while\nholding nothing: a dropped\nrelease waits for the next key"; pos="-545.0,135.0!" ];
c_sr [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="State resend\nbaselines := unknown\nretries := 0"; pos="560.0,-130.0!"; "link-c"="../../../right/src/usb_report_sender.c:/^void UsbReportSender_RequestStateResend/,/^}/" ];
t1 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="host ready"; pos="860.0,-250.0!" ];
t2 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="usb awake"; pos="860.0,-205.0!" ];
t3 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="host switch"; pos="860.0,-160.0!" ];
t4 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="dongle host awake"; pos="860.0,-115.0!" ];
t5 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="late confirmation"; pos="860.0,-70.0!" ];
t6 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="confirmation raced\na failure"; pos="860.0,-15.0!" ];

// ---------- sinks ----------
s_sinks [ fontsize="15.6"; label="Sinks\n(where Send goes)"; pos="0.0,330.0!" ];

// USB
u0 [ fontsize="15.6"; label="USB"; pos="-800.0,410.0!" ];
u1 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="[c2usb] endpoint holds\none report"; pos="-800.0,490.0!" ];
u2 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="host polls"; pos="-1000.0,570.0!" ];
u3 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="callback ok:\nRelease"; pos="-1000.0,650.0!" ];
pc1 [ fontsize="12.0"; label="PC (USB)"; pos="-1000.0,730.0!" ];
u4 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="host doesn't poll"; pos="-800.0,570.0!" ];
u5 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="busy, timeouts:\ngive up"; pos="-800.0,650.0!" ];
u6 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="polled late"; pos="-800.0,730.0!" ];
u7 [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="late confirmation:\nstate resend"; pos="-800.0,810.0!" ];
u8 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="bus suspended"; pos="-580.0,570.0!" ];
u9 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="report dropped,\nhost woken"; pos="-580.0,650.0!"; "link-c"="../../../right/src/hid/transport.cpp:/^static errno_t sendUsb/,/^}/" ];
u10 [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="usb awake:\nstate resend"; pos="-580.0,730.0!" ];
u11 [ fontsize="12.0"; label="GAP: a tap while\nsuspended is lost"; pos="-580.0,810.0!" ];
u12 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="interface not started\n(mouse, controls)"; pos="-1230.0,570.0!" ];
u13 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="not sent"; pos="-1230.0,650.0!" ];
u14 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="reconfiguration"; pos="-1080.0,410.0!" ];
u15 [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="ClearSink:\nnothing in flight"; pos="-1320.0,410.0!"; "link-c"="../../../right/src/hid/transport_usb.cpp:/UsbSemaphore_ClearSink/,+0" ];

// HOGP
h0 [ fontsize="15.6"; label="HOGP (BLE)"; pos="0.0,410.0!"; "link-c"="../../../../c2usb/c2usb/bluetooth/hid_over_gatt.cpp" ];
h1 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="accepted: queued\nin [Zephyr] ATT"; pos="0.0,490.0!" ];
h2 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="[c2usb + Zephyr]\nsent callback"; pos="0.0,570.0!" ];
h3 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="Release"; pos="0.0,650.0!" ];
pc2 [ fontsize="12.0"; label="PC (BLE)"; pos="0.0,730.0!" ];
h4 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="never resent"; pos="-270.0,570.0!" ];
h_inv [ fontsize="12.0"; label="INVARIANT:\nHOGP reports are never resent:\nin order, or the link goes down"; pos="-290.0,655.0!" ];
h5 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="pool full: -ENOMEM"; pos="280.0,490.0!" ];
h6 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="retry with backoff"; pos="280.0,570.0!" ];
h7 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="unconfirmed 1 s"; pos="280.0,650.0!" ];
h8 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="disconnect\nthat connection"; pos="280.0,730.0!"; "link-c"="../../../right/src/usb_report_sender.c:/^void UsbReportSender_TearDownStalledLink/,/^}/" ];
h9 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="[c2usb] session ends"; pos="280.0,810.0!" ];
h10 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="ReleaseConnection:\nnothing in flight"; pos="280.0,890.0!"; "link-c"="../../../device/src/connections.c:/UsbSemaphore_ReleaseConnection/,+0" ];
h11 [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="one more pass\nafter 1 s"; pos="280.0,970.0!" ];

// dongle
d0 [ fontsize="15.6"; label="Dongle"; pos="800.0,410.0!" ];
d1 [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="right half -> dongle:\nMessenger over NUS"; pos="800.0,490.0!" ];
d2 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="handed to NUS:\nRelease"; pos="800.0,570.0!" ];
d_gap [ fontsize="12.0"; label="GAP: no end-to-end\nconfirmation"; pos="1070.0,570.0!" ];
d3 [ fillcolor="#ccaf76"; color="#19150e"; fontsize="12.0"; label="dongle relay loop:\none report at a time"; pos="800.0,650.0!"; "link-c"="../../../device/src/messenger.c:/^static void sendDongleReportUntilDone/,/^}/" ];
d9 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="sender's resend events cleared:\nonly the loop resends"; pos="1110.0,650.0!"; "link-c"="../../../right/src/user_logic.c:/EventVector_ResendUsbReports/,+0" ];
d4 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="callback ok"; pos="620.0,730.0!" ];
pc3 [ fontsize="12.0"; label="PC (via dongle)"; pos="620.0,810.0!" ];
d5 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="error, or 32 ms"; pos="840.0,730.0!" ];
d6 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="resend"; pos="840.0,810.0!" ];
d7 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="12 tries,\nor host gone"; pos="1070.0,735.0!" ];
d8 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="give up:\nreport lost"; pos="1070.0,815.0!" ];
d_gap2 [ fontsize="12.0"; label="GAP: the dongle has no state\nof its own to resend"; pos="1070.0,895.0!" ];

// ---------- stalled link ----------
s0 [ fontsize="15.6"; label="Stalled link"; pos="1200.0,-700.0!" ];
s1 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="peer radio up,\nits stack takes no data"; pos="1200.0,-620.0!" ];
s2 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="HOGP report\nunconfirmed 1 s"; pos="1070.0,-540.0!" ];
s3 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="no NUS send slot\nin 1 s"; pos="1330.0,-540.0!" ];
s4 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="disconnect only\nthat connection"; pos="1200.0,-460.0!" ];
s_inv [ fontsize="12.0"; label="INVARIANT:\na link that stops taking data\nis torn down, and only that link"; pos="920.0,-450.0!" ];
s5 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="link down frees\nits buffers"; pos="1200.0,-380.0!" ];
s6 [ fillcolor="#a3cc8e"; color="#141911"; fontsize="12.0"; label="reset resends key states\nand sync properties"; pos="1200.0,-300.0!" ];
s7 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="[Zephyr] a released ATT channel\nclears its TX metadata:\nno use-after-free"; pos="1200.0,-210.0!" ];

// ---------- shared BLE buffers ----------
p0 [ fontsize="15.6"; label="Shared BLE buffers"; pos="1750.0,-700.0!"; "link-c"="../../../device/prj.conf.overlays/nrf_shared.conf:/^# ATT TX PDUs in flight/,/^CONFIG_BT_ATT_TX_ALLOC_TIMEOUT/" ];
p1 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="[Zephyr] one ATT TX pool\nfor all BLE links: 8"; pos="1750.0,-620.0!" ];
p7 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="why: a stalled link + 32 ms\nresends once filled the pool:\na 55 s freeze"; pos="2040.0,-620.0!" ];
p2 [ fillcolor="#a7adcc"; color="#141519"; fontsize="12.0"; label="caps per sender:\nHID 3, NUS server 2,\nNUS client 1, battery 1"; pos="1750.0,-530.0!" ];
p_inv [ fontsize="12.0"; label="INVARIANT:\neach sender caps its PDUs;\nthe caps fit in the pool (7 + 1)"; pos="2040.0,-530.0!" ];
p3 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="pool full"; pos="1750.0,-440.0!" ];
p4 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="[Zephyr patch] -ENOMEM,\nallocation never blocks"; pos="1750.0,-360.0!"; "link-c"="../../../patches/zephyr/0001-bluetooth-att-make-TX-buffer-wait-configurable.patch" ];
p5 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="sender retries\nwith backoff"; pos="1750.0,-280.0!" ];
p6 [ fillcolor="#cc9b9b"; color="#191313"; fontsize="12.0"; label="-ENOMEM and report > MTU:\nNKRO -> 6KRO"; pos="2040.0,-360.0!"; "link-c"="../../../right/src/hid/transport.cpp:/^static bool fitsBleMtu/,/^}/" ];
p_gap [ fontsize="12.0"; label="GAP: [radio] HCI send credits (3)\nare shared and not capped:\na NUS timeout may cut a healthy\nlink during a HOGP stall"; pos="1750.0,-170.0!" ];

// title, legend
kt -> kt_d;
kt -> s_left;
lg0 -> lg1;
lg1 -> lg2;
lg2 -> lg3;
lg3 -> lg4;
lg4 -> lg5;
lg5 -> lg6;

// left half
s_left -> a_scan;
s_left -> a_mod;
s_left -> a_ss;
a_scan -> a_msg;
a_mod -> a_msg;
a_ss -> a_msg;
a_msg -> a_test;
a_msg -> a_ok;
a_msg -> a_fail;
a_fail -> a_mark;
a_fail -> a_inv;
a_mark -> a_gap;
a_reset -> a_all;
a_all -> a_msg;
a_ok -> s_link;

// link between the halves
s_link -> b_uart;
s_link -> b_nus;
b_uart -> b_ack;
b_uart -> b_nack;
b_nack -> b_rsnd;
b_uart -> b_ping;
b_ping -> b_down;
b_down -> b_kres;
b_nus -> b_slot;
b_slot -> b_radio;
b_nus -> b_noslot;
b_noslot -> b_cut;
b_noslot -> b_gap;
b_cut -> s0;
b_ack -> b_wm;
b_radio -> b_wm;
b_wm -> s_right;

// right half
s_right -> s_main;
s_main -> s_snd;

// report sender
s_snd -> c_doc;
s_snd -> c_gate;
c_gate -> c_inv_seq;
c_gate -> c_gap_pm;
s_snd -> c_pass;
c_pass -> c_down;
c_pass -> c_send;
c_send -> c_acc;
c_acc -> c_conf;
c_conf -> c_adv;
c_adv -> c_inv_base;
c_send -> c_rej;
c_acc -> c_to;
c_to -> c_inv_wait;
c_rej -> c_fail;
c_to -> c_fail;
c_fail -> c_retry;
c_fail -> c_give;
c_give -> c_drop;
c_drop -> c_latch;
c_drop -> c_rec;
c_drop -> c_gap_w1;
t1 -> c_sr;
t2 -> c_sr;
t3 -> c_sr;
t4 -> c_sr;
t5 -> c_sr;
t6 -> c_sr;
c_sr -> c_pass;

// sinks
s_sinks -> u0;
s_sinks -> h0;
s_sinks -> d0;

u0 -> u1;
u1 -> u2;
u2 -> u3;
u3 -> pc1;
u1 -> u4;
u4 -> u5;
u5 -> u6;
